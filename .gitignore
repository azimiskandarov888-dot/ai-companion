# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.Python

# Environment / secrets — NEVER commit real keys
.env
.env.local
*.env
!.env.example

# Runtime data (conversation logs, audio, per-user memory).
# Ignore the *contents* but keep the folder + templates tracked.
backend/data/*
!backend/data/.gitkeep
!backend/data/facts.example.json
!backend/data/persona.example.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Xcode / iOS build output (generated on the Mac — never commit)
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/DerivedData/
ios/build/
*.xcodeproj/project.xcworkspace/xcuserdata/
# The .xcodeproj is generated from project.yml by XcodeGen (or created in Xcode).
ios/*.xcodeproj

# Logs
*.log
