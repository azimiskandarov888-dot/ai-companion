# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.Python

# Environment / secrets — NEVER commit real keys
.env
.env.local
*.env
!.env.example

# Safety net for loose files people paste keys into by mistake. Real keys belong
# ONLY in backend/.env (ignored above). These names must never be committed.
api keys
api keys.*
api-keys*
apikeys*
keys.txt
secrets.txt
*.secret
*secret*.txt

# Runtime data (conversation logs, audio, per-user memory).
# Ignore the *contents* but keep the folder + templates tracked.
backend/data/*
!backend/data/.gitkeep
!backend/data/facts.example.json
!backend/data/persona.example.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Xcode / iOS build output (generated on the Mac — never commit)
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/DerivedData/
ios/build/
*.xcodeproj/project.xcworkspace/xcuserdata/
# The .xcodeproj is generated from project.yml by XcodeGen (or created in Xcode).
ios/*.xcodeproj

# Logs
*.log

# Browser automation scratch (screenshots, traces, downloads from Playwright MCP).
# Generated art belongs in assets/raw/ under its exact name — never here.
.browser/

# Claude Code per-machine settings. The shared .claude/settings.json IS tracked.
.claude/settings.local.json
