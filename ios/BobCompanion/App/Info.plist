<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The seven keys every app bundle must have. Xcode used to inject these
         invisibly when XcodeGen generated this file for us — which was also
         what let it silently overwrite everything below on every run. Now that
         this file is used as-is, they have to actually be here, or the
         simulator refuses to install it ("Missing bundle ID"). The $(...)
         forms are filled in by Xcode from the target's build settings at
         build time, same as Apple's own template. -->
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- The app's own name, shown under the icon. Renaming the app is this
         line plus AppInfo.displayName in SettingsScreen.swift. -->
    <key>CFBundleDisplayName</key>
    <string>Боб</string>

    <!-- Russian ships first. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>ru</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>ru</string>
        <string>en</string>
    </array>

    <!-- WITHOUT THIS the app runs in legacy compatibility mode: iOS letterboxes
         it with black bars top and bottom and hands it a smaller, older screen
         size, which breaks every full-bleed photograph and squeezes every
         layout. An empty-ish UILaunchScreen is all it takes to get the real
         screen. The colour is `night`, so the first frame is never white. -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>

    <!-- Why we need the mic. He can't be a friend if he can't hear you. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Он слушает, только когда вы говорите с ним, чтобы ответить вам вслух.</string>

    <!-- Needed to reach the backend running on your Mac over local Wi-Fi. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Приложение отправляет ваш голос на ваш сервер, чтобы он мог ответить.</string>

    <!-- Keep audio alive. Foreground docked use needs this for reliable capture;
         it's also the foundation for the later background/floating-window layer. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- DEV ONLY: the test backend is plain http on the LAN. For production use
         https and remove NSAllowsArbitraryLoads. NSAllowsLocalNetworking permits
         http to a local IP without opening everything up. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- Docked device: stay awake, portrait, no idle sleep. -->
    <key>UIApplicationSupportsIndefinitePreciseLocationRequirement</key>
    <false/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIRequiresPersistentWiFi</key>
    <true/>
</dict>
</plist>
