# Copy this file to .env.local and fill in your key.

# Your Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Optional: give your companion a name (defaults to "Aria")
# NEXT_PUBLIC_COMPANION_NAME=Aria
