# Copy this file to .env and fill in your keys, then restart the server.
# NEVER commit the real .env — it holds secrets. (.gitignore already blocks it.)

# --- Brain: Claude (required) ---------------------------------------------
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Ears: OpenAI Whisper (required for voice input) ----------------------
# https://platform.openai.com/
OPENAI_API_KEY=sk-...
# WHISPER_MODEL=whisper-1

# --- Mouth: the voice (OPTIONAL) ------------------------------------------
# Which voice provider speaks Bob:
#   yandex      Russian voices made for Russian. Best prosody, cheap. ← start here
#   openai      uses OPENAI_API_KEY above. No signup. Decent, slight accent.
#   elevenlabs  the most natural of all, and several times the price.
#   fish        cheap, but the library is community-uploaded — mostly meme and
#               character voices, very little that suits a calm conversation.
#   (blank)     the phone's own free voice — fine for early testing.
#
# Hear them all before choosing:  python3 audition.py --yandex
#                                 python3 audition.py --openai NOTE: this is only the VOICE —
# the ears stay on Whisper above (Fish Audio can't hear Russian).
#
# WHAT RUSSIAN COSTS, per hour of speech — the headline prices mislead badly,
# because Cyrillic is TWO UTF-8 bytes per letter and some providers bill bytes:
#
#   yandex standard   ~33 ₽/hour     ← cheapest, and Russian voices made by Russians
#   yandex premium    ~66 ₽/hour
#   openai            ~$0.71/hour    ← no extra signup, uses OPENAI_API_KEY above
#   fish              ~$1.65/hour    ← $15 per 1M BYTES, so ~$30 per 1M Russian chars
#   elevenlabs        ~$8.25/hour
#
# Hear them side by side first:  python3 audition.py --compare
# See the whole story:           python3 audition.py --cost   ·  docs/HIS-VOICE.md
TTS_PROVIDER=fish

# Fish Audio. Get a key at https://fish.audio/ , pick a voice from
# fish.audio/discovery and paste its id as FISH_VOICE_ID. If you stay on Fish,
# try FISH_MODEL=s2-pro — S2 wins blind tests against ElevenLabs; s1 is older.
FISH_API_KEY=
FISH_VOICE_ID=
# TWO VOICES. About half the companions the app invents are women, and
# with one voice setting every one of them spoke as a man. Fish has no
# sensible default — pick a second id from fish.audio/discovery.
FISH_VOICE_ID_FEMALE=
# FISH_MODEL=s1        # or s2-pro — noticeably better, same price

# Yandex SpeechKit — the cheapest and the most Russian-sounding of the four.
# Setup is fifteen minutes and no code: docs/HIS-VOICE.md § "Setting up Yandex".
#   console.yandex.cloud → billing → copy the folder id →
#   IAM → service account `speechkit-sa` with role ai.speechkit-tts.user →
#   create an API key (shown once) → paste both below → TTS_PROVIDER=yandex
# Voices are BARE NAMES — no `:premium` suffix. Much of Yandex's own
# documentation still shows `filipp:premium`; the API rejects it with a 400.
# Premium tier (better, ~2x price):  filipp (m) · alena (f)
# Standard tier:                     ermil · zahar · jane · omazh · oksana
# Which names your account actually has:  python3 audition.py --yandex
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_VOICE=filipp             # a male companion
# YANDEX_VOICE_FEMALE=alena       # …and a female one — see below
# YANDEX_EMOTION=         # LEAVE EMPTY. It is a crude one-tone-per-utterance
#                         # override that only the STANDARD voices take; the
#                         # premium ones read each sentence and choose their
#                         # own intonation, which is better. Empty = expressive.
# YANDEX_SPEED=0.95       # just under 1.0 — kinder to an older listener

# OpenAI voice — no extra signup, uses OPENAI_API_KEY above.
# Voices: ash · onyx · fable · ballad · echo · sage · verse · alloy · nova ·
# coral · shimmer.  Start with ash or onyx for a warm older man.
# OPENAI_VOICE=ash                # a male companion
# OPENAI_VOICE_FEMALE=sage        # …and a female one
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# How he speaks, in plain words — this matters as much as which voice:
# OPENAI_VOICE_STYLE=Тёплый, неторопливый пожилой друг. Говори спокойно...

# ElevenLabs (warmer, pricier) — only used if you set TTS_PROVIDER=elevenlabs.
# https://elevenlabs.io/
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Companion settings ----------------------------------------------------
# COMPANION_NAME=Соня
# The person he/she is talking to (used gently in greetings). Optional.
# ELDER_NAME=
# COMPANION_LANGUAGE=ru
# MAX_REPLY_TOKENS=400
