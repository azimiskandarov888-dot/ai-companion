# Copy this file to .env and fill in your keys, then restart the server.
# NEVER commit the real .env — it holds secrets. (.gitignore already blocks it.)

# --- Brain: Claude (required) ---------------------------------------------
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Ears: OpenAI Whisper (required for voice input) ----------------------
# https://platform.openai.com/
OPENAI_API_KEY=sk-...
# WHISPER_MODEL=whisper-1

# --- Mouth: ElevenLabs (required for voice output) ------------------------
# https://elevenlabs.io/
ELEVENLABS_API_KEY=...
# Pick a warm, neutral, Russian-suited voice from your ElevenLabs library and
# paste its Voice ID here. Default below is a gentle preset ("Sarah").
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Companion settings ----------------------------------------------------
# COMPANION_NAME=Соня
# The person he/she is talking to (used gently in greetings). Optional.
# ELDER_NAME=
# COMPANION_LANGUAGE=ru
# MAX_REPLY_TOKENS=400
