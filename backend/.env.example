# Copy this file to .env and fill in your keys, then restart the server.
# NEVER commit the real .env — it holds secrets. (.gitignore already blocks it.)

# --- Brain: Claude (required) ---------------------------------------------
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Ears: OpenAI Whisper (required for voice input) ----------------------
# https://platform.openai.com/
OPENAI_API_KEY=sk-...
# WHISPER_MODEL=whisper-1

# --- Mouth: the voice (OPTIONAL) ------------------------------------------
# Which voice provider speaks Bob:  fish | openai | elevenlabs | (blank = free
# browser voice for the MVP). Default is fish. NOTE: this is only the VOICE —
# the ears stay on Whisper above (Fish Audio can't hear Russian).
#
# openai is the one to start with: it uses the OPENAI_API_KEY you already have
# above, costs the same as Fish, speaks Russian, and is reachable in places
# where fish.audio is not. Audition them all:  python3 audition.py --openai
TTS_PROVIDER=fish

# Fish Audio (cheaper, open-weight). Get a key at https://fish.audio/ , pick a
# warm Russian voice from its library and paste that voice's id as FISH_VOICE_ID.
FISH_API_KEY=
FISH_VOICE_ID=
# FISH_MODEL=s1        # or s2-pro for the newest open-weight model

# OpenAI voice — no extra signup, uses OPENAI_API_KEY above.
# Voices: ash · onyx · fable · ballad · echo · sage · verse · alloy · nova ·
# coral · shimmer.  Start with ash or onyx for a warm older man.
# OPENAI_VOICE=ash
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# How he speaks, in plain words — this matters as much as which voice:
# OPENAI_VOICE_STYLE=Тёплый, неторопливый пожилой друг. Говори спокойно...

# ElevenLabs (warmer, pricier) — only used if you set TTS_PROVIDER=elevenlabs.
# https://elevenlabs.io/
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Companion settings ----------------------------------------------------
# COMPANION_NAME=Соня
# The person he/she is talking to (used gently in greetings). Optional.
# ELDER_NAME=
# COMPANION_LANGUAGE=ru
# MAX_REPLY_TOKENS=400
